# Readyio API (api.readyio.com): CMS + website forms in one process.
# Copy to .env and fill in real values. Never commit .env.

# ---- Server ----
NODE_ENV=production
PORT=4000

# ---- MySQL (Amazon RDS uses SSL automatically when global-bundle.pem is present) ----
DB_HOST=your-db-host.rds.amazonaws.com
DB_PORT=3306
DB_USER=readyio_app
DB_PASS=change-me
DB_NAME=readyio_db

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-plus-random-characters

# ---- Admin user seeded/updated by `npm run migrate` ----
# Re-running the migration resets this user's password to ADMIN_PASSWORD.
ADMIN_EMAIL=admin@readyio.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_USERNAME=admin

# ---- Public URLs ----
SITE_URL=https://readyio.com
BLOG_SITE_URL=https://blog.readyio.com
# Extra CORS origins, comma-separated. readyio.com, www.readyio.com, blog.readyio.com,
# blogpanel.readyio.com and the localhost dev ports are always allowed.
CORS_ORIGIN=

# ---- Cache (Upstash Redis REST). Optional: the API works without it, just slower. ----
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
CACHE_KEY_PREFIX=readyio

# ---- Image uploads from the admin panel ----
# When the DO_SPACES_* keys are set, uploads go to DigitalOcean Spaces; otherwise to Cloudinary.
# Folder (key prefix) for uploaded images in either store.
UPLOAD_FOLDER=readyio-blog

# DigitalOcean Spaces (DigitalOcean > API > Spaces Keys)
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=your-bucket
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# Optional: public base URL, e.g. the Spaces CDN https://your-bucket.blr1.cdn.digitaloceanspaces.com
# Default: https://<bucket>.<region>.digitaloceanspaces.com
DO_SPACES_CDN_URL=

# Cloudinary: hosts the 6 original post images (used by `npm run seed:legacy-posts`)
# and is the upload target when Spaces is not configured.
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=readyio-blog

# ---- On-demand revalidation of readyio.com and blog.readyio.com after publishing ----
# Same value as REVALIDATE_SECRET in readyiosite/.env.local and readyiosite-blog/.env.local.
REVALIDATE_SECRET=replace-with-a-long-random-string
# On the VPS the Next.js apps are reachable on localhost, so no public round trip is needed.
REVALIDATE_WEBHOOKS=http://127.0.0.1:8080/api/revalidate,http://127.0.0.1:8081/api/revalidate

# ---- Email (chatbot booking confirmations + lead notifications) ----
# Gmail: use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@readyio.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=hello@readyio.com
# Where new chatbot leads are sent (falls back to ADMIN_EMAIL, then hello@readyio.com).
LEAD_NOTIFICATION_EMAIL=hello@readyio.com

# ---- AI chatbot (OpenRouter). Optional: without it the bot uses rule-based replies. ----
OPENROUTER_API_KEY=your-openrouter-key

# ---- Only for `npm run seed:legacy-posts` (defaults to ../Frontend/src/assets) ----
# LEGACY_ASSETS_DIR=/path/to/Frontend/src/assets
